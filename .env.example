# Skopiuj do .env.local i uzupełnij. Wymagany minimum: GEMINI_API_KEY (lub GOOGLE_API_KEY dla Places).

# Gemini – https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Domyślnie alias na najnowszy model Flash. Możesz przypiąć konkretną wersję.
GEMINI_MODEL=gemini-flash-latest

# Google Cloud: włącz "Places API (New)" oraz "PageSpeed Insights API"
GOOGLE_API_KEY=
# Opcjonalnie osobny klucz dla PageSpeed (domyślnie GOOGLE_API_KEY)
PAGESPEED_API_KEY=

# CEIDG – bezpłatny token: https://dane.biznes.gov.pl/pl/dane-po-api
CEIDG_API_TOKEN=
# CEIDG_API_URL=https://dane.biznes.gov.pl/api/ceidg/v3

# GUS REGON (BIR1) – bezpłatny klucz z GUS. REGON_TEST=1 = środowisko testowe z kluczem publicznym.
REGON_API_KEY=
REGON_TEST=0

# Kontakt w User-Agent (wymagane przez politykę Nominatim/OSM)
CONTACT_EMAIL=

# Plik bazy SQLite
DATABASE_PATH=./data/app.db
